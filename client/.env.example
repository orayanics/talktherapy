# Make sure to create a .env file in the client directory with the following content:
HTTPS=false 
VITE_STAGE=development
VITE_APP_API_URL=http://localhost:8080 # use pc ip for local dev https
VITE_APP_WSS_URL=ws://localhost:8081 # use pc ip for local dev https
VITE_REVERB_APP_KEY=local
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Set these to approved production values before publishing the homepage.
# Use an HTTPS origin without a path and an absolute HTTPS social image URL.
VITE_PUBLIC_ORIGIN=
VITE_PUBLIC_SOCIAL_IMAGE_URL=
VITE_PUBLIC_OPERATOR=
VITE_PUBLIC_PRIVACY_URL=
VITE_PUBLIC_SUPPORT_URL=
