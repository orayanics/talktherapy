# Make sure to create a .env file in the client directory with the following content:
HTTPS=true
VITE_STAGE=production
VITE_SERVER_PORT=8080
VITE_APP_API_URL=https://0.0.0.0:8080
VITE_APP_WSS_URL=wss://0.0.0.0:8080
VITE_REVERB_APP_KEY=local
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Better-Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://192.168.1.10:3000 # Base URL of your app
