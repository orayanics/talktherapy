@@ -0,0 +1,10 @@
+import MDEditor from '@uiw/react-md-editor'
+import rehypeSanitize from 'rehype-sanitize'
+
+export default function ContentBody({ source }: { source: string }) {
+  return (
+    <MDEditor.Markdown source={source} rehypePlugins={[rehypeSanitize]} />
+  )
+}
diff --git a/client/src/modules/content/components/ContentBody.test.tsx b/client/src/modules/content/components/ContentBody.test.tsx
new file mode 100644
--- /dev/null
+++ b/client/src/modules/content/components/ContentBody.test.tsx
@@ -0,0 +1,17 @@
+/** @vitest-environment jsdom */
+import { render } from '@testing-library/react'
+import { expect, it } from 'vitest'
+import ContentBody from './ContentBody'
+
+it('sanitizes raw HTML and unsafe link protocols in content markdown', () => {
+  const { container } = render(
+    <ContentBody
+      source={'<img src="x" onerror="alert(1)">\n\n[unsafe](javascript:alert(1))'}
+    />,
+  )
+
+  expect(container.querySelector('[onerror]')).toBeNull()
+  expect(container.querySelector('a[href^="javascript:"]')).toBeNull()
+})
